# Backend / General
DATABASE_URL=sqlite:///./lexflowai.db
JWT_SECRET=change_this_secret

# OpenAI (default drafting provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: point drafting at any OpenAI-compatible endpoint instead of
# OpenAI directly (e.g. Gemini's OpenAI-compat API). If unset, falls back
# to OPENAI_API_KEY / OPENAI_MODEL / OpenAI's own endpoint.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=lexflowai-index

# Optional: other AI providers
AI4BHARAT_API_KEY=
GEMINI_API_KEY=

# Sarvam AI (translation: hi-IN, te-IN)
SARVAM_API_KEY=your_sarvam_api_key_here

# eCourtsIndia (case tracking / CNR lookup)
ECOURTS_API_KEY=your_ecourts_api_key_here

# Razorpay (billing - test-mode keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Run `python -m app.create_razorpay_plan` once to create the recurring
# Individual plan and get this id.
RAZORPAY_PLAN_ID_INDIVIDUAL=
# Same idea for the firm-level Team plan (multi-seat shared cases).
RAZORPAY_PLAN_ID_TEAM=
# Set in the Razorpay dashboard webhook config (Settings > Webhooks) once
# the backend has a public HTTPS URL; must match exactly.
RAZORPAY_WEBHOOK_SECRET=

# CORS - comma-separated list of allowed frontend origins in production
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
